# Copy to .env.local. Never commit .env.local (ADR-0010).
# Content channel: preview (all statuses, drafts flagged) or production (approved only).
CONTENT_RELEASE=preview
# Search-engine indexing: off until public launch (M4).
SITE_INDEXING=off
# Absolute site URL; required for production deployments.
# NEXT_PUBLIC_SITE_URL=https://example.org
# Where published audio is served from (ADR-0006).
AUDIO_BASE_URL=/audio

# Only for `npm run audio:generate` on your own machine. Never set these in CI or on the host.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
ENDPOINT=