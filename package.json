{
  "name": "pd3-mundtlig",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "predev": "npm run content:build",
    "dev": "next dev",
    "prebuild": "npm run i18n:global-error && npm run content:build",
    "build": "next build",
    "postbuild": "npm run check:leaks",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --grep-invert @budget",
    "check:budgets": "playwright test --grep @budget --project=mobile-chromium",
    "check:leaks": "tsx scripts/ci/check-build-leaks.ts",
    "content:extract": "tsx scripts/content/extract.ts",
    "content:validate": "tsx scripts/content/validate.ts",
    "content:build": "tsx scripts/content/build-read-model.ts",
    "content:check": "tsx scripts/content/check-fidelity.ts",
    "content:check:pdf": "tsx scripts/content/check-pdf.ts && tsx scripts/content/check-siri.ts",
    "i18n:global-error": "node scripts/i18n/global-error-messages.ts",
    "audio:generate": "node --env-file-if-exists=.env.local --import tsx scripts/audio/generate.ts",
    "audio:voices": "node --env-file-if-exists=.env.local --import tsx scripts/audio/voices.ts",
    "audio:samples": "node --env-file-if-exists=.env.local --import tsx scripts/audio/samples.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "clsx": "2.1.1",
    "idb": "8.0.4",
    "lucide-react": "1.76.0",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-better-tailwindcss": "4.11.0",
    "fake-indexeddb": "6.2.8",
    "fast-check": "4.10.3",
    "jsdom": "31.0.1",
    "microsoft-cognitiveservices-speech-sdk": "1.53.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@swc/core": false,
    "@parcel/watcher": false,
    "fsevents": false
  }
}
